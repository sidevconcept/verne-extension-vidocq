<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>exemple.verne</groupId>
    <artifactId>application-processeurs</artifactId>
    <version>1.0.0</version>
    <name>Application avec deux processeurs de compilation</name>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <verne.version>0.1.0-SNAPSHOT</verne.version>
        <voisin.version>1.0.0</voisin.version>
    </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>retirer-les-sorties-perimees</id>
                        <phase>initialize</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <executions>
                    <execution>
                        <!-- Les tests utilisent les classes principales : Verne ne régénère pas les gabarits pour eux. -->
                        <id>default-testCompile</id>
                        <configuration><proc>none</proc></configuration>
                    </execution>
                </executions>
                <configuration>
                    <proc>full</proc>
                    <compilerArgs>
                        <arg>-Averne.racine.gabarits=${project.basedir}/src/main/verne</arg>
                        <arg>-Averne.paquet=exemple.gabarits</arg>
                        <arg>-Averne.profil.sortie=texte</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>classique</id>
            <activation><activeByDefault>true</activeByDefault></activation>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.vidocq.verne</groupId>
                            <artifactId>verne-compilation</artifactId>
                            <version>${verne.version}</version>
                        </path>
                        <path>
                            <groupId>exemple.verne</groupId>
                            <artifactId>processeur-voisin</artifactId>
                            <version>${voisin.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs combine.children="append">
                        <arg>-Avoisin.chargement=classique</arg>
                    </compilerArgs>
                </configuration>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>modules</id>
            <properties>
                <verne.archive.processeur>${settings.localRepository}/io/vidocq/verne/verne-compilation/${verne.version}/verne-compilation-${verne.version}.jar</verne.archive.processeur>
                <voisin.archive.processeur>${settings.localRepository}/exemple/verne/processeur-voisin/${voisin.version}/processeur-voisin-${voisin.version}.jar</voisin.archive.processeur>
            </properties>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs combine.children="append">
                        <arg>--processor-module-path</arg>
                        <arg>${verne.archive.processeur}${path.separator}${voisin.archive.processeur}</arg>
                        <arg>-Avoisin.chargement=modules</arg>
                    </compilerArgs>
                </configuration>
            </plugin></plugins></build>
        </profile>
    </profiles>
</project>
