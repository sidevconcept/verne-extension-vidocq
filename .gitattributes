* text=auto
*.java text eol=lf
*.xml text eol=lf
*.adoc text eol=lf
*.md text eol=lf
mvnw text eol=lf
mvnw.cmd text eol=crlf
# Préserver les octets du témoin CRLF, y compris dans les archives de sources.
exemples/application-maven/src/main/verne/bonjour.verne -text whitespace=cr-at-eol
exemples/application-processeurs/src/main/verne/bonjour.verne -text whitespace=cr-at-eol
# Les gabarits des mesures sont comparés octet par octet à des témoins en LF.
verne-mesures/src/test/verne/*.verne text eol=lf
